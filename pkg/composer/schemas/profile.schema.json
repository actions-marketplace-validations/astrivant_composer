{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Composer runtime profile",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "services"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              },
              "namespace": {
                "type": "string"
              },
              "labels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "anyOf": [
              {
                "required": [
                  "name"
                ]
              },
              {
                "required": [
                  "labels"
                ]
              }
            ]
          },
          "container": {
            "type": "string"
          },
          "init": {
            "type": "boolean"
          },
          "remove": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "set": {
            "type": "object"
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "set": {
          "type": "object"
        }
      }
    },
    "volumes": {
      "type": "object"
    },
    "networks": {
      "type": "object"
    }
  }
}
